/* ── 29. MISC UTILITIES ───────────────────────────────────── */
.hidden { display: none !important; }
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
.text-accent { color: var(--accent); }
.text-gold   { color: var(--gold); }
