function watchMovie(id) {
  if (!state.user) {
    showToast('يرجى تسجيل الدخول أولاً', 'error');
    setTimeout(() => openModal('loginModal'), 500);
    return;
  }
  const movie = [...MOVIES, ...SERIES].find(m => m.id === id);
  if (!movie) return;

  // Add to watch history
  const now = new Date().toLocaleDateString('ar-SA');
  const existing = state.watchHistory.findIndex(h => h.id === id);
  if (existing === -1) state.watchHistory.unshift({ id, date: now });
  localStorage.setItem('cmx_history', JSON.stringify(state.watchHistory));

  openModal('watchModal');
}

