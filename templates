function checkStrength(val) {
  const bar  = document.getElementById('strengthBar');
  const text = document.getElementById('strengthText');
  if (!bar || !text) return;
  let score = 0;
  if (val.length >= 8)            score++;
  if (/[A-Z]/.test(val))          score++;
  if (/[0-9]/.test(val))          score++;
  if (/[^A-Za-z0-9]/.test(val))  score++;

  const levels = [
    { w: '25%',  bg: '#ef4444', label: 'ضعيفة جداً' },
    { w: '50%',  bg: '#f97316', label: 'ضعيفة' },
    { w: '75%',  bg: '#eab308', label: 'متوسطة' },
    { w: '100%', bg: '#22c55e', label: 'قوية ✓' },
  ];
  const lvl = levels[Math.max(0, score - 1)] || levels[0];
  bar.style.width      = val ? lvl.w  : '0';
  bar.style.background = lvl.bg;
  text.textContent     = val ? lvl.label : 'أدخل كلمة مرور';
  text.style.color     = val ? lvl.bg  : 'var(--text3)';
}

