    setTimeout(() => { titleEl.textContent = HERO_DATA[idx].title; titleEl.style.opacity = '1'; }, 300);
  }
  state.heroSlide = idx;
}

function nextSlide() {
  const total = document.querySelectorAll('.hero-bg-slide').length;
  setHeroSlide((state.heroSlide + 1) % total);
}
function prevSlide() {
  const total = document.querySelectorAll('.hero-bg-slide').length;
  setHeroSlide((state.heroSlide - 1 + total) % total);
  resetHeroInterval();
}

function resetHeroInterval() {
  clearInterval(state.heroInterval);
  state.heroInterval = setInterval(nextSlide, 6000);
}

document.querySelectorAll('.hero-dot').forEach((dot, i) => {
