    if (g === 'الكل') pill.classList.add('active');
    pill.addEventListener('click', () => {
      document.querySelectorAll('.genre-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      if (g === 'الكل') {
        const grid = document.getElementById('trendingGrid');
        const header = document.querySelector('#movies .section-title');
        if (header) header.textContent = '🔥 الأكثر رواجاً';
        if (grid) grid.innerHTML = MOVIES.slice(0,8).map(movieCard).join('');
      } else {
        filterCategory(g);
      }
    });
    bar.appendChild(pill);
  });

  const moviesSection = document.getElementById('movies');
  moviesSection?.insertBefore(bar, moviesSection.querySelector('.movies-grid'));
})();



/* ══ IMAGE EDITOR ════════════════════════════════════════ */

const ORIGINAL_HERO = [
  'https://image.tmdb.org/t/p/original/628Dep6AxEtDxjZoGP78TsOxYbK.jpg',
  'https://image.tmdb.org/t/p/original/9n2tJBplPbgR2ca05hS5CKXwP2c.jpg',
  'https://image.tmdb.org/t/p/original/hv7o3VgfsairBoQFAawgaQ4cR1m.jpg',
];
const ORIGINAL_FEATURED = 'https://image.tmdb.org/t/p/w500/8Gxv8gSFCU0XGDykEGv7zR1n2ua.jpg';

let editorOpen = false;
let heroImages = [...ORIGINAL_HERO];
let movieImageOverrides = {};

function toggleEditor() {
  editorOpen = !editorOpen;
  document.getElementById('editorPanel').classList.toggle('open', editorOpen);
  if (editorOpen) {
    buildHeroSlots();
    buildMovieEditList();
  }
}

/* ── EP TABS ── */
function switchEpTab(btn, tabId) {
  document.querySelectorAll('.ep-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.ep-tab-content').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById(tabId)?.classList.add('active');
  if (tabId === 'ep-movies') buildMovieEditList();
}

/* ── HERO SLOTS ── */
function buildHeroSlots() {
  const c = document.getElementById('heroSlotsContainer');
  if (!c) return;
  const slides = document.querySelectorAll('.hero-bg-slide');
  c.innerHTML = '';
  slides.forEach((slide, i) => {
    const url = heroImages[i] || '';
    const div = document.createElement('div');
    div.className = 'hero-slot';
    div.innerHTML = `
      <div class="hero-slot-header">
        <div class="hero-slot-num">${i+1}</div>
        <span>صورة الشريحة ${i+1}</span>
      </div>
      <img class="hero-slot-preview" id="heroPreview${i}" src="${url}" onerror="this.style.opacity=0.2" />
      <div class="hero-slot-input">
        <input type="text" id="heroUrl${i}" placeholder="https://..." value="${url}" oninput="liveHeroPreview(${i},this.value)" />
        <button onclick="applyHeroSlide(${i})">تطبيق</button>
      </div>`;
    c.appendChild(div);

    // File upload per slot
    const uploadWrap = document.createElement('div');
    uploadWrap.style.cssText = 'padding:0.5rem 0.85rem;border-top:1px solid var(--border)';
    uploadWrap.innerHTML = `
      <input type="file" id="heroFile${i}" accept="image/*" style="display:none" onchange="handleHeroSlotFile(event,${i})" />
      <label for="heroFile${i}" style="font-size:0.72rem;color:var(--text3);cursor:pointer;display:flex;align-items:center;gap:0.4rem">
        <span>📁</span> رفع من الجهاز للشريحة ${i+1}
      </label>`;
    div.appendChild(uploadWrap);
  });
}

function liveHeroPreview(i, url) {
  const prev = document.getElementById(`heroPreview${i}`);
  if (prev) { prev.src = url; prev.style.opacity = 1; }
}

function applyHeroSlide(i) {
  const url = document.getElementById(`heroUrl${i}`)?.value?.trim();
  if (!url) return showToast('أدخل رابط URL', 'error');
  const slides = document.querySelectorAll('.hero-bg-slide');
  if (slides[i]) {
    slides[i].style.backgroundImage = `url('${url}')`;
    heroImages[i] = url;
    showToast(`✓ تم تحديث صورة الشريحة ${i+1}`, 'success');
  }
}

function handleHeroSlotFile(e, i) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    const url = ev.target.result;
    const slides = document.querySelectorAll('.hero-bg-slide');
    if (slides[i]) slides[i].style.backgroundImage = `url('${url}')`;
    heroImages[i] = url;
    const prev = document.getElementById(`heroPreview${i}`);
    const inp  = document.getElementById(`heroUrl${i}`);
    if (prev) { prev.src = url; prev.style.opacity = 1; }
    if (inp) inp.value = '(صورة محلية مرفوعة)';
    showToast(`✓ تم رفع صورة الشريحة ${i+1}`, 'success');
  };
  reader.readAsDataURL(file);
}

function handleHeroFileUpload(e) { handleHeroSlotFile(e, state.heroSlide); }

function resetHeroImages() {
  const slides = document.querySelectorAll('.hero-bg-slide');
  ORIGINAL_HERO.forEach((url, i) => {
    if (slides[i]) slides[i].style.backgroundImage = `url('${url}')`;
    heroImages[i] = url;
  });
  buildHeroSlots();
  showToast('↺ تم استعادة صور الهيرو', 'success');
}

/* ── MOVIE EDIT LIST ── */
function buildMovieEditList() {
  const c = document.getElementById('movieEditList');
  if (!c) return;
  const all = [...MOVIES, ...SERIES];
  c.innerHTML = all.map(m => {
    const currentPoster = movieImageOverrides[m.id] || m.poster;
    return `
    <div class="movie-edit-card">
      <img class="movie-edit-thumb" id="meThumb${m.id}" src="${currentPoster}" alt="${m.title}"
        onerror="this.src='https://via.placeholder.com/44x62/161d30/5a6480?text=🎬'" />
      <div class="movie-edit-info">
        <div class="movie-edit-title">${m.title}</div>
        <input class="movie-edit-url" id="meUrl${m.id}"
          placeholder="رابط الصورة الجديدة..."
          value="${movieImageOverrides[m.id] || ''}"
          oninput="liveMoviePreview(${m.id}, this.value)" />
        <div class="movie-edit-actions">
          <button class="movie-edit-apply" onclick="applyMovieImage(${m.id})">✓ تطبيق</button>
          <button class="movie-edit-reset" onclick="resetMovieImage(${m.id})">↺</button>
          <input type="file" id="meFile${m.id}" accept="image/*" style="display:none" onchange="handleMovieFile(event,${m.id})" />
          <label for="meFile${m.id}" style="font-size:0.68rem;color:var(--text3);cursor:pointer;padding:0.25rem 0.4rem;background:var(--surface2);border-radius:4px;border:1px solid var(--border)">📁</label>
        </div>
      </div>
    </div>`;
  }).join('');
}

function liveMoviePreview(id, url) {
  if (!url) return;
  const thumb = document.getElementById(`meThumb${id}`);
  if (thumb) thumb.src = url;
}

function applyMovieImage(id) {
  const url = document.getElementById(`meUrl${id}`)?.value?.trim();
  if (!url) return showToast('أدخل رابط URL', 'error');
  applyMovieImageTo(id, url);
  showToast('✓ تم تحديث صورة الفيلم', 'success');
}

function applyMovieImageTo(id, url) {
  movieImageOverrides[id] = url;
  // Update all visible posters for this movie
  document.querySelectorAll(`.movie-card`).forEach(card => {
    const playBtn = card.querySelector('.card-btn-play');
    if (playBtn && playBtn.getAttribute('onclick')?.includes(`watchMovie(${id})`)) {
      const img = card.querySelector('.movie-poster');
      if (img) img.src = url;
    }
  });
  // Update top list thumbs
  document.querySelectorAll('.top-thumb').forEach(img => {
    if (img.alt === [...MOVIES,...SERIES].find(m => m.id === id)?.title) img.src = url;
  });
  const thumb = document.getElementById(`meThumb${id}`);
  if (thumb) thumb.src = url;
  // Rebuild grids with overrides
  rebuildGrids();
}

function handleMovieFile(e, id) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    const url = ev.target.result;
    const inp = document.getElementById(`meUrl${id}`);
    if (inp) inp.value = '(صورة محلية)';
    applyMovieImageTo(id, url);
    showToast('✓ تم رفع الصورة', 'success');
  };
  reader.readAsDataURL(file);
}

function resetMovieImage(id) {
  delete movieImageOverrides[id];
  const m = [...MOVIES,...SERIES].find(x => x.id === id);
  if (m) applyMovieImageTo(id, m.poster);
  const inp = document.getElementById(`meUrl${id}`);
  if (inp) inp.value = '';
  const thumb = document.getElementById(`meThumb${id}`);
  if (thumb) thumb.src = m?.poster || '';
  showToast('↺ تم استعادة الصورة الأصلية');
}

function resetMovieImages() {
  movieImageOverrides = {};
  rebuildGrids();
  buildMovieEditList();
  showToast('↺ تم استعادة جميع الصور الأصلية', 'success');
}

/* Patch movieCard to respect overrides */
const _origMovieCard = movieCard;
window.movieCard = function(m) {
  const patched = movieImageOverrides[m.id]
    ? { ...m, poster: movieImageOverrides[m.id] }
    : m;
  return _origMovieCard(patched);
};

function rebuildGrids() {
  const tg = document.getElementById('trendingGrid');
  const ng = document.getElementById('newGrid');
  const sg = document.getElementById('seriesGrid');
  if (tg) tg.innerHTML = MOVIES.slice(0,8).map(movieCard).join('');
  if (ng) ng.innerHTML = [...MOVIES].reverse().slice(0,10).map(movieCard).join('');
  if (sg) sg.innerHTML = SERIES.map(movieCard).join('');
  renderTopRated();
}

/* ── FEATURED IMAGE ── */
function applyFeaturedImage() {
  const url = document.getElementById('featuredUrlInput')?.value?.trim();
  if (!url) return showToast('أدخل رابط URL', 'error');
  const img = document.querySelector('.featured-image img');
  if (img) img.src = url;
  document.getElementById('epFeaturedPreview').src = url;
  showToast('✓ تم تحديث صورة البانر', 'success');
}

function handleFeaturedFile(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    const url = ev.target.result;
    const img = document.querySelector('.featured-image img');
    if (img) img.src = url;
    document.getElementById('epFeaturedPreview').src = url;
    showToast('✓ تم رفع صورة البانر', 'success');
  };
  reader.readAsDataURL(file);
}

function resetFeaturedImage() {
  const img = document.querySelector('.featured-image img');
  if (img) img.src = ORIGINAL_FEATURED;
  document.getElementById('epFeaturedPreview').src = ORIGINAL_FEATURED;
  document.getElementById('featuredUrlInput').value = '';
  showToast('↺ تم استعادة صورة البانر');
}

function applyFeaturedText() {
  const title = document.getElementById('featuredTitleInput')?.value;
  const desc  = document.getElementById('featuredDescInput')?.value;
  const fh2 = document.querySelector('.featured-content h2');
  const fp  = document.querySelector('.featured-content p');
  if (fh2 && title) fh2.textContent = title;
  if (fp  && desc)  fp.textContent  = desc;
  showToast('✓ تم تحديث نص البانر', 'success');
}

/* ── THEME ── */
function applyAccent(swatch) {
  document.querySelectorAll('#accentSwatches .swatch').forEach(s => s.classList.remove('active'));
  swatch.classList.add('active');
  const accent  = swatch.dataset.accent;
  const accent2 = swatch.dataset.accent2;
  document.documentElement.style.setProperty('--accent',  accent);
  document.documentElement.style.setProperty('--accent2', accent2);
  document.getElementById('customAccent').value = accent;
  showToast('✓ تم تغيير اللون', 'success');
}

function applyCustomAccent(val) {
  document.documentElement.style.setProperty('--accent',  val);
  document.documentElement.style.setProperty('--accent2', val + 'cc');
  document.querySelectorAll('#accentSwatches .swatch').forEach(s => s.classList.remove('active'));
}

function applyBg(bg, bg2, bg3) {
  document.documentElement.style.setProperty('--bg',  bg);
  document.documentElement.style.setProperty('--bg2', bg2);
  document.documentElement.style.setProperty('--bg3', bg3);
  showToast('✓ تم تغيير خلفية الموقع', 'success');
}

function resetTheme() {
  document.documentElement.style.setProperty('--accent',  '#e50914');
  document.documentElement.style.setProperty('--accent2', '#ff4c54');
  document.documentElement.style.setProperty('--bg',  '#080b14');
  document.documentElement.style.setProperty('--bg2', '#0d1117');
  document.documentElement.style.setProperty('--bg3', '#12172a');
  document.getElementById('customAccent').value = '#e50914';
  showToast('↺ تم استعادة الألوان الأصلية', 'success');
}



/* ══ AVATAR MANAGEMENT ══════════════════════════════════ */

const DEFAULT_AVATAR_BASE = 'https://ui-avatars.com/api/?background=e50914&color=fff&size=200&name=';

function getAvatarUrl() {
  return localStorage.getItem('cmx_avatar') || '';
}

function setAvatarEverywhere(url) {
  // Nav bar small img
  const navImg = document.getElementById('avatarImg');
  if (navImg) { navImg.src = url; navImg.style.display = 'block'; }
  // Profile modal big img
  const profImg = document.getElementById('profileAvatarImg');
  if (profImg) profImg.src = url;
  // Save
  localStorage.setItem('cmx_avatar', url);
  if (state.user) { state.user.avatar = url; localStorage.setItem('cmx_user', JSON.stringify(state.user)); }
}

function handleAvatarFile(e) {
  const file = e.target.files[0];
  if (!file) return;
  if (file.size > 5 * 1024 * 1024) return showToast('الصورة أكبر من 5 ميغابايت!', 'error');
  const reader = new FileReader();
  reader.onload = ev => {
    setAvatarEverywhere(ev.target.result);
    showToast('✓ تم تحديث الصورة الشخصية!', 'success');
  };
  reader.readAsDataURL(file);
}

function applyAvatarUrl() {
  const url = document.getElementById('avatarUrlInput')?.value?.trim();
  if (!url) return showToast('أدخل رابط الصورة', 'error');
  // Quick validate: test the image loads
  const testImg = new Image();
  testImg.onload  = () => { setAvatarEverywhere(url); showToast('✓ تم تحديث الصورة الشخصية!', 'success'); };
  testImg.onerror = () => showToast('تعذّر تحميل الصورة، تحقق من الرابط', 'error');
  testImg.src = url;
}

function removeAvatar() {
  const name = state.user?.name || 'User';
  const url = DEFAULT_AVATAR_BASE + encodeURIComponent(name);
  setAvatarEverywhere(url);
  localStorage.removeItem('cmx_avatar');
  const inp = document.getElementById('avatarUrlInput');
  if (inp) inp.value = '';
  showToast('↺ تم حذف الصورة الشخصية');
}

/* Patch updateAuthUI to also restore avatar */
const _origUpdateAuthUI = updateAuthUI;
window.updateAuthUI = function() {
  _origUpdateAuthUI();
  if (state.user) {
    const saved = getAvatarUrl();
    const name  = state.user.name || 'User';
    const url   = saved || (DEFAULT_AVATAR_BASE + encodeURIComponent(name));
    setAvatarEverywhere(url);
    // Sync url input
    const inp = document.getElementById('avatarUrlInput');
    if (inp && saved) inp.value = saved;
    // Set profile name/email displayed
    const profImg = document.getElementById('profileAvatarImg');
    if (profImg) profImg.src = url;
  }
};

// Load saved avatar on page ready
document.addEventListener('DOMContentLoaded', () => {
  const saved = getAvatarUrl();
  if (saved) {
    const navImg = document.getElementById('avatarImg');
    if (navImg) navImg.src = saved;
  }
});

</script>

