/* ── 31. BACK TO TOP ─────────────────────────────────────── */
#backTop {
  position: fixed; bottom: 2rem; right: 2rem;
  width: 44px; height: 44px;
  background: var(--accent);
  border: none;
  border-radius: 50%;
  color: #fff;
  font-size: 1.2rem;
  display: flex; align-items: center; justify-content: center;
  z-index: 800;
  opacity: 0;
  transform: translateY(20px);
  transition: all var(--transition);
  box-shadow: 0 4px 20px rgba(229,9,20,0.4);
}
#backTop.visible { opacity: 1; transform: translateY(0); }
#backTop:hover { background: var(--accent2); transform: translateY(-3px); }

/* ── 32. GENRE FILTER BAR ────────────────────────────────── */
.genre-filter-bar {
  display: flex; gap: 0.5rem;
  padding: 0 4rem 1.5rem;
  overflow-x: auto;
  scrollbar-width: none;
}
.genre-filter-bar::-webkit-scrollbar { display: none; }
.genre-pill {
  flex-shrink: 0;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--text2);
  padding: 0.4rem 1rem;
  border-radius: 50px;
  font-size: 0.82rem;
  font-weight: 600;
  transition: all var(--transition);
  cursor: none;
}
.genre-pill:hover, .genre-pill.active { background: var(--accent); border-color: var(--accent); color: #fff; }

/* ── 33. TOOLTIP ─────────────────────────────────────────── */
[data-tip] { position: relative; }
[data-tip]::after {
  content: attr(data-tip);
  position: absolute;
  bottom: calc(100% + 6px);
  left: 50%;
  transform: translateX(-50%);
  background: var(--surface2);
  border: 1px solid var(--border);
  color: var(--text);
  font-size: 0.74rem;
  padding: 0.3rem 0.6rem;
  border-radius: 5px;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition);
}
[data-tip]:hover::after { opacity: 1; }

/* ── 34. RATING STARS ─────────────────────────────────────── */
.stars { display: inline-flex; gap: 2px; color: var(--text3); font-size: 0.9rem; }
.stars .filled { color: var(--gold); }

/* ── 35. BADGE VARIANTS ───────────────────────────────────── */
.badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.7rem; font-weight: 700; }
.badge-red    { background: rgba(229,9,20,0.15); color: var(--accent2); border: 1px solid rgba(229,9,20,0.3); }
.badge-gold   { background: rgba(245,197,24,0.15); color: var(--gold); border: 1px solid rgba(245,197,24,0.3); }
.badge-blue   { background: rgba(0,119,255,0.15); color: #5ba4ff; border: 1px solid rgba(0,119,255,0.3); }
.badge-purple { background: rgba(121,40,202,0.15); color: #a855f7; border: 1px solid rgba(121,40,202,0.3); }

/* ── 36. SHIMMER CARD PLACEHOLDER ────────────────────────── */
.card-placeholder {
  background: linear-gradient(90deg, var(--surface) 25%, var(--surface2) 50%, var(--surface) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
  border-radius: var(--radius);
  aspect-ratio: 2/3;
}

/* ── 37. SECTION DIVIDER ──────────────────────────────────── */
.divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--border), transparent);
  margin: 0 4rem;
}

/* ── 38. HOVER CARD GLOW ──────────────────────────────────── */
.movie-card::after {
  content: '';
  position: absolute; inset: 0;
  border-radius: var(--radius);
  box-shadow: 0 0 30px rgba(229,9,20,0.25);
  opacity: 0;
  transition: opacity var(--transition);
  pointer-events: none;
}
.movie-card:hover::after { opacity: 1; }

/* ── 39. LETTER SPACING UTILITY ───────────────────────────── */
.ls-wide { letter-spacing: 0.12em; }
.ls-tight { letter-spacing: -0.02em; }

/* ── 40. FOCUS VISIBLE ─────────────────────────────────────── */
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: 4px;
}

/* ── 41. REDUCED MOTION ────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}


