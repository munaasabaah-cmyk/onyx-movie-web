<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CineMax – أفضل تجربة سينمائية</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&family=Bebas+Neue&display=swap" rel="stylesheet" />
  <style>
/* ═══════════════════════════════════════════════════════════
   CINEMAX — MAIN STYLESHEET
   ═══════════════════════════════════════════════════════════ */

/* ── 1. RESET & ROOT ──────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:        #080b14;
  --bg2:       #0d1117;
  --bg3:       #12172a;
  --surface:   #161d30;
  --surface2:  #1e2740;
  --accent:    #e50914;
  --accent2:   #ff4c54;
  --gold:      #f5c518;
  --blue:      #0077ff;
  --text:      #f0f0f0;
  --text2:     #a0aabf;
  --text3:     #5a6480;
  --border:    rgba(255,255,255,0.07);
  --radius:    12px;
  --radius-lg: 20px;
  --transition: 0.3s cubic-bezier(0.4,0,0.2,1);
  --glow:      0 0 40px rgba(229,9,20,0.3);
  --font:      'Cairo', sans-serif;
}

html { scroll-behavior: smooth; font-size: 16px; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font);
  direction: rtl;
  overflow-x: hidden;
  cursor: none;
}

a { text-decoration: none; color: inherit; }
ul { list-style: none; }
img { max-width: 100%; display: block; }
button { cursor: none; font-family: var(--font); }
input, select, textarea { font-family: var(--font); }

/* ── 2. SCROLLBAR ─────────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg2); }
::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--accent2); }

/* ── 3. SELECTION ─────────────────────────────────────────── */
::selection { background: var(--accent); color: #fff; }

/* ── 4. CUSTOM CURSOR ─────────────────────────────────────── */
#cursor {
  position: fixed;
  width: 14px; height: 14px;
  background: var(--accent);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%,-50%);
  transition: transform 0.1s, width 0.2s, height 0.2s, background 0.2s;
  mix-blend-mode: screen;
}
#cursor-blur {
  position: fixed;
  width: 40px; height: 40px;
  border: 1.5px solid rgba(229,9,20,0.5);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9998;
  transform: translate(-50%,-50%);
  transition: all 0.15s ease-out;
}
body:has(button:hover) #cursor,
body:has(a:hover) #cursor { width: 22px; height: 22px; background: var(--accent2); }

/* ── 5. LOADER ────────────────────────────────────────────── */
#loader {
  position: fixed; inset: 0;
  background: var(--bg);
  z-index: 10000;
  display: flex; align-items: center; justify-content: center;
  transition: opacity 0.6s ease, visibility 0.6s;
}
#loader.hidden { opacity: 0; visibility: hidden; }

.loader-inner { text-align: center; }

.loader-logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 4rem;
  letter-spacing: 0.1em;
  color: var(--text);
  margin-bottom: 2rem;
}
.loader-logo span { color: var(--accent); }

.loader-bar {
  width: 260px; height: 3px;
  background: var(--surface);
  border-radius: 2px;
  overflow: hidden;
  margin: 0 auto;
}
.loader-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
  border-radius: 2px;
  animation: loaderAnim 2s ease forwards;
}
@keyframes loaderAnim { from { width: 0 } to { width: 100% } }

/* ── 6. NAVBAR ────────────────────────────────────────────── */
#navbar {
  position: fixed; top: 0; left: 0; right: 0;
  z-index: 1000;
  padding: 0 2rem;
  height: 70px;
  display: flex; align-items: center;
  background: transparent;
  transition: background var(--transition), box-shadow var(--transition);
}
#navbar.scrolled {
  background: rgba(8,11,20,0.95);
  backdrop-filter: blur(20px);
  box-shadow: 0 2px 40px rgba(0,0,0,0.5);
}

.nav-container {
  width: 100%;
  display: flex; align-items: center; gap: 2rem;
}

.nav-logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.8rem;
  letter-spacing: 0.08em;
  flex-shrink: 0;
}
.nav-logo span { color: var(--accent); }

.nav-links {
  display: flex; gap: 0.25rem;
  flex: 1;
  justify-content: center;
}
.nav-links a {
  padding: 0.5rem 1rem;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text2);
  transition: color var(--transition), background var(--transition);
  position: relative;
}
.nav-links a::after {
  content: '';
  position: absolute;
  bottom: 2px; left: 50%; right: 50%;
  height: 2px;
  background: var(--accent);
  border-radius: 1px;
  transition: left var(--transition), right var(--transition);
}
.nav-links a:hover, .nav-links a.active { color: var(--text); }
.nav-links a:hover::after, .nav-links a.active::after { left: 12%; right: 12%; }

.nav-right { display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; }

.nav-search {
  display: flex; align-items: center;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  transition: border-color var(--transition), box-shadow var(--transition);
}
.nav-search:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(229,9,20,0.15);
}
.nav-search input {
  background: transparent;
  border: none;
  outline: none;
  color: var(--text);
  padding: 0.5rem 1rem;
  width: 200px;
  font-size: 0.85rem;
}
.nav-search input::placeholder { color: var(--text3); }
.search-btn {
  background: none;
  border: none;
  padding: 0.5rem 0.75rem;
  color: var(--text2);
  display: flex;
  transition: color var(--transition);
}
.search-btn:hover { color: var(--accent); }
.search-btn svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; }

.btn-login {
  background: transparent;
  border: 1.5px solid var(--border);
  color: var(--text);
  padding: 0.45rem 1.1rem;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 600;
  transition: border-color var(--transition), color var(--transition);
}
.btn-login:hover { border-color: var(--accent); color: var(--accent); }

.btn-register {
  background: var(--accent);
  border: 1.5px solid var(--accent);
  color: #fff;
  padding: 0.45rem 1.1rem;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 700;
  transition: background var(--transition), box-shadow var(--transition);
}
.btn-register:hover {
  background: var(--accent2);
  box-shadow: 0 0 20px rgba(229,9,20,0.4);
}

.user-avatar {
  position: relative;
  cursor: none;
}
.user-avatar img {
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 2px solid var(--accent);
  object-fit: cover;
}
.user-avatar.hidden { display: none; }

.user-dropdown {
  position: absolute;
  top: calc(100% + 0.5rem);
  left: 0;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  min-width: 160px;
  padding: 0.5rem 0;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: all var(--transition);
  box-shadow: 0 8px 32px rgba(0,0,0,0.4);
}
.user-avatar:hover .user-dropdown {
  opacity: 1; visibility: visible; transform: translateY(0);
}
.user-dropdown a {
  display: block;
  padding: 0.6rem 1rem;
  font-size: 0.85rem;
  color: var(--text2);
  transition: color var(--transition), background var(--transition);
}
.user-dropdown a:hover { color: var(--text); background: rgba(255,255,255,0.05); }

/* ── 7. HERO ──────────────────────────────────────────────── */
.hero {
  position: relative;
  height: 100vh; min-height: 600px;
  overflow: hidden;
  display: flex; align-items: center;
}

.hero-bg { position: absolute; inset: 0; }
.hero-bg-slide {
  position: absolute; inset: 0;
  background-size: cover;
  background-position: center top;
  opacity: 0;
  transition: opacity 1.2s ease;
  transform: scale(1.05);
  animation: kenBurns 12s ease infinite alternate;
}
.hero-bg-slide.active { opacity: 1; }
@keyframes kenBurns {
  from { transform: scale(1.05); }
  to   { transform: scale(1); }
}

.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(
    90deg,
    rgba(8,11,20,0.95) 0%,
    rgba(8,11,20,0.7) 50%,
    rgba(8,11,20,0.1) 100%
  ), linear-gradient(
    0deg,
    rgba(8,11,20,1) 0%,
    transparent 40%
  );
}

.hero-content {
  position: relative; z-index: 2;
  max-width: 650px;
  padding: 0 4rem;
  animation: heroIn 1s ease 0.5s both;
}
@keyframes heroIn {
  from { opacity: 0; transform: translateY(40px); }
  to   { opacity: 1; transform: translateY(0); }
}

.hero-badge {
  display: inline-flex; align-items: center; gap: 0.4rem;
  background: rgba(229,9,20,0.15);
  border: 1px solid rgba(229,9,20,0.4);
  color: var(--accent2);
  font-size: 0.8rem;
  font-weight: 700;
  padding: 0.35rem 0.85rem;
  border-radius: 50px;
  margin-bottom: 1rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.hero-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(3rem, 7vw, 6rem);
  line-height: 1;
  letter-spacing: 0.04em;
  color: #fff;
  text-shadow: 0 4px 30px rgba(0,0,0,0.5);
  margin-bottom: 0.75rem;
}

.hero-meta {
  display: flex; align-items: center; gap: 0.6rem;
  color: var(--text2);
  font-size: 0.9rem;
  font-weight: 600;
  margin-bottom: 1rem;
}
.dot { color: var(--text3); }
.rating { color: var(--gold); }
.genre-tag {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.15);
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  font-size: 0.78rem;
  color: var(--text2);
}

.hero-desc {
  color: var(--text2);
  font-size: 1rem;
  line-height: 1.7;
  max-width: 500px;
  margin-bottom: 2rem;
}

.hero-btns { display: flex; gap: 1rem; }

.btn-watch {
  display: inline-flex; align-items: center; gap: 0.6rem;
  background: var(--accent);
  color: #fff;
  border: none;
  padding: 0.85rem 2rem;
  border-radius: var(--radius);
  font-size: 1rem;
  font-weight: 700;
  transition: background var(--transition), box-shadow var(--transition), transform var(--transition);
}
.btn-watch svg {
  width: 18px; height: 18px;
  stroke: none; fill: #fff;
}
.btn-watch:hover {
  background: var(--accent2);
  box-shadow: var(--glow);
  transform: translateY(-2px);
}

.btn-info {
  display: inline-flex; align-items: center; gap: 0.6rem;
  background: rgba(255,255,255,0.1);
  border: 1.5px solid rgba(255,255,255,0.15);
  color: #fff;
  padding: 0.85rem 2rem;
  border-radius: var(--radius);
  font-size: 1rem;
  font-weight: 600;
  backdrop-filter: blur(10px);
  transition: background var(--transition), border-color var(--transition), transform var(--transition);
}
.btn-info svg { width: 18px; height: 18px; stroke: #fff; fill: none; stroke-width: 2; }
.btn-info:hover {
  background: rgba(255,255,255,0.18);
  border-color: rgba(255,255,255,0.3);
  transform: translateY(-2px);
}

.hero-controls {
  position: absolute; bottom: 3rem; left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  display: flex; align-items: center; gap: 1rem;
}
.hero-prev, .hero-next {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  color: #fff;
  width: 40px; height: 40px;
  border-radius: 50%;
  font-size: 1rem;
  display: flex; align-items: center; justify-content: center;
  transition: background var(--transition);
}
.hero-prev:hover, .hero-next:hover { background: var(--accent); border-color: var(--accent); }

.hero-dots { display: flex; gap: 0.5rem; }
.hero-dot {
  width: 8px; height: 8px;
  background: rgba(255,255,255,0.3);
  border-radius: 50%;
  transition: background var(--transition), width var(--transition);
  cursor: none;
}
.hero-dot.active {
  background: var(--accent);
  width: 24px;
  border-radius: 4px;
}

.hero-scroll {
  position: absolute; bottom: 2rem; right: 4rem;
  z-index: 3;
  display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
  color: var(--text3);
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.scroll-arrow {
  width: 20px; height: 20px;
  border-bottom: 2px solid var(--text3);
  border-right: 2px solid var(--text3);
  transform: rotate(45deg);
  animation: scrollBounce 1.5s ease infinite;
}
@keyframes scrollBounce {
  0%,100% { transform: rotate(45deg) translateY(0); }
  50%      { transform: rotate(45deg) translateY(4px); }
}

/* ── 8. STATS BAR ─────────────────────────────────────────── */
.stats-bar {
  background: linear-gradient(135deg, var(--surface), var(--surface2));
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 1.5rem 4rem;
}
.stat-item {
  text-align: center;
  border-left: 1px solid var(--border);
  padding: 0.75rem 1rem;
}
.stat-item:last-child { border-left: none; }
.stat-num {
  display: block;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 2.5rem;
  color: var(--accent);
  letter-spacing: 0.05em;
  line-height: 1;
}
.stat-label {
  display: block;
  font-size: 0.8rem;
  color: var(--text2);
  margin-top: 0.25rem;
}

/* ── 9. SECTIONS ──────────────────────────────────────────── */
.section {
  padding: 3rem 4rem;
}

.section-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 1.75rem;
}
.section-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text);
}
.section-title.center { text-align: center; width: 100%; }
.section-sub { color: var(--text2); text-align: center; margin-top: 0.5rem; margin-bottom: 2rem; }

.see-all {
  font-size: 0.85rem;
  color: var(--accent);
  font-weight: 600;
  transition: color var(--transition);
}
.see-all:hover { color: var(--accent2); }

/* ── 10. MOVIES GRID ──────────────────────────────────────── */
.movies-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1.25rem;
}

.movie-card {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--surface);
  transition: transform var(--transition), box-shadow var(--transition);
  cursor: none;
}
.movie-card:hover {
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  z-index: 2;
}
.movie-card:hover .card-overlay { opacity: 1; }
.movie-card:hover .card-info { transform: translateY(0); opacity: 1; }

.movie-poster {
  width: 100%;
  aspect-ratio: 2/3;
  object-fit: cover;
  display: block;
  transition: transform var(--transition);
}
.movie-card:hover .movie-poster { transform: scale(1.05); }

.card-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(0deg, rgba(8,11,20,0.95) 0%, rgba(8,11,20,0.3) 60%, transparent 100%);
  opacity: 0;
  transition: opacity var(--transition);
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: 1rem;
}

.card-info { transform: translateY(10px); opacity: 0; transition: all var(--transition); }
.card-title { font-size: 0.9rem; font-weight: 700; color: #fff; margin-bottom: 0.3rem; line-height: 1.3; }
.card-meta { font-size: 0.75rem; color: var(--text2); display: flex; gap: 0.5rem; margin-bottom: 0.75rem; }
.card-rating { color: var(--gold); font-weight: 700; }

.card-btns { display: flex; gap: 0.5rem; }
.card-btn-play {
  flex: 1;
  background: var(--accent);
  border: none; color: #fff;
  padding: 0.45rem;
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: 600;
  transition: background var(--transition);
  display: flex; align-items: center; justify-content: center; gap: 0.3rem;
}
.card-btn-play:hover { background: var(--accent2); }
.card-btn-fav {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  color: #fff;
  width: 34px; height: 34px;
  border-radius: 6px;
  font-size: 1rem;
  display: flex; align-items: center; justify-content: center;
  transition: background var(--transition), color var(--transition);
}
.card-btn-fav:hover { background: rgba(229,9,20,0.2); color: var(--accent); }
.card-btn-fav.active { color: var(--accent); }

.card-badge {
  position: absolute; top: 0.6rem; right: 0.6rem;
  background: var(--accent);
  color: #fff;
  font-size: 0.68rem;
  font-weight: 700;
  padding: 0.2rem 0.5rem;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.card-badge.new { background: var(--blue); }
.card-badge.series { background: #7928ca; }

/* ── 11. MOVIES ROW ───────────────────────────────────────── */
.movies-row {
  display: flex;
  gap: 1.25rem;
  overflow-x: auto;
  padding-bottom: 1rem;
  scrollbar-width: thin;
  scrollbar-color: var(--accent) var(--surface);
}
.movies-row .movie-card { flex: 0 0 180px; }
.movies-row::-webkit-scrollbar { height: 4px; }
.movies-row::-webkit-scrollbar-track { background: var(--surface); }
.movies-row::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 2px; }

/* ── 12. FEATURED BANNER ──────────────────────────────────── */
.featured-banner {
  margin: 0 4rem;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, #0a0f20 0%, #161d30 50%, #1a0a0a 100%);
  border: 1px solid var(--border);
  display: flex;
  overflow: hidden;
  position: relative;
}
.featured-banner::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 70% 50%, rgba(229,9,20,0.08) 0%, transparent 70%);
}
.featured-content {
  flex: 1;
  padding: 3rem;
  display: flex; flex-direction: column; justify-content: center;
  position: relative; z-index: 1;
}
.featured-badge {
  display: inline-block;
  background: var(--accent);
  color: #fff;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.3rem 0.8rem;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 1rem;
  width: fit-content;
}
.featured-content h2 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 3.5rem;
  letter-spacing: 0.06em;
  color: #fff;
  margin-bottom: 0.75rem;
}
.featured-content p {
  color: var(--text2);
  font-size: 0.95rem;
  line-height: 1.7;
  max-width: 420px;
  margin-bottom: 1rem;
}
.featured-meta {
  display: flex; gap: 0.75rem; align-items: center;
  color: var(--text2); font-size: 0.85rem;
  margin-bottom: 1.5rem;
}
.featured-meta span:first-child { color: var(--gold); font-weight: 700; }
.featured-image {
  width: 300px; flex-shrink: 0;
  position: relative; overflow: hidden;
}
.featured-image img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: brightness(0.85);
  transition: filter var(--transition), transform var(--transition);
}
.featured-banner:hover .featured-image img { filter: brightness(1); transform: scale(1.03); }

/* ── 13. CATEGORIES ───────────────────────────────────────── */
.categories-section { text-align: center; }
.categories-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-top: 2rem;
}
.cat-card {
  padding: 2rem 1rem;
  border-radius: var(--radius);
  background: var(--surface);
  border: 1px solid var(--border);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text2);
  transition: all var(--transition);
  cursor: none;
  position: relative;
  overflow: hidden;
}
.cat-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--clr, var(--accent));
  opacity: 0;
  transition: opacity var(--transition);
}
.cat-card:hover::before { opacity: 0.12; }
.cat-card:hover {
  border-color: var(--clr, var(--accent));
  color: var(--text);
  transform: translateY(-4px);
  box-shadow: 0 8px 30px rgba(0,0,0,0.3);
}

/* ── 14. TOP RATED LIST ───────────────────────────────────── */
.top-list {
  display: flex; flex-direction: column; gap: 0.75rem;
}
.top-item {
  display: flex; align-items: center; gap: 1.25rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0.85rem 1.25rem;
  transition: background var(--transition), transform var(--transition);
  cursor: none;
}
.top-item:hover { background: var(--surface2); transform: translateX(-4px); }

.top-rank {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.8rem;
  color: var(--accent);
  width: 2.5rem;
  text-align: center;
  flex-shrink: 0;
}
.top-item:nth-child(1) .top-rank { color: var(--gold); }
.top-item:nth-child(2) .top-rank { color: #c0c0c0; }
.top-item:nth-child(3) .top-rank { color: #cd7f32; }

.top-thumb {
  width: 60px; height: 85px;
  border-radius: 8px;
  object-fit: cover;
  flex-shrink: 0;
}
.top-details { flex: 1; }
.top-title { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 0.3rem; }
.top-meta { font-size: 0.8rem; color: var(--text2); display: flex; gap: 0.75rem; }
.top-score { color: var(--gold); font-weight: 700; }

.top-score-circle {
  width: 50px; height: 50px;
  border-radius: 50%;
  background: conic-gradient(var(--gold) calc(var(--pct) * 1%), var(--surface2) 0%);
  display: flex; align-items: center; justify-content: center;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--gold);
  flex-shrink: 0;
  position: relative;
}
.top-score-circle::after {
  content: '';
  position: absolute;
  inset: 5px;
  background: var(--surface);
  border-radius: 50%;
  z-index: -1;
}

/* ── 15. PLANS ────────────────────────────────────────────── */
.plans-section {
  background: var(--bg2);
  padding: 4rem;
}
.plans-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-top: 2.5rem;
  max-width: 1000px;
  margin-left: auto;
  margin-right: auto;
}
.plan-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 2rem 1.75rem;
  text-align: center;
  position: relative;
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
}
.plan-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 50px rgba(0,0,0,0.35);
}
.plan-card.featured-plan {
  border-color: var(--accent);
  background: linear-gradient(160deg, var(--surface2) 0%, #1a0a12 100%);
  box-shadow: 0 0 40px rgba(229,9,20,0.2);
}
.plan-card.featured-plan:hover { box-shadow: 0 0 60px rgba(229,9,20,0.35); }

.plan-badge {
  position: absolute;
  top: -14px; left: 50%;
  transform: translateX(-50%);
  background: var(--accent);
  color: #fff;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.25rem 1rem;
  border-radius: 50px;
  white-space: nowrap;
  letter-spacing: 0.04em;
}
.plan-name {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text2);
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.plan-price {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 3rem;
  color: var(--text);
  letter-spacing: 0.04em;
  margin-bottom: 1.5rem;
}
.plan-price span { font-family: var(--font); font-size: 1rem; color: var(--text2); }

.plan-features { text-align: right; margin-bottom: 1.75rem; }
.plan-features li {
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--border);
  font-size: 0.875rem;
  color: var(--text2);
}
.plan-features li:last-child { border-bottom: none; }
.plan-features li.no { color: var(--text3); text-decoration: line-through; }

.btn-plan {
  width: 100%;
  background: var(--surface2);
  border: 1.5px solid var(--border);
  color: var(--text);
  padding: 0.75rem;
  border-radius: var(--radius);
  font-size: 0.95rem;
  font-weight: 700;
  transition: all var(--transition);
}
.btn-plan:hover { border-color: var(--accent); color: var(--accent); }
.btn-plan.primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  box-shadow: 0 4px 20px rgba(229,9,20,0.3);
}
.btn-plan.primary:hover { background: var(--accent2); box-shadow: var(--glow); }

/* ── 16. FOOTER ───────────────────────────────────────────── */
.footer {
  background: var(--bg2);
  border-top: 1px solid var(--border);
  padding: 3rem 4rem 1.5rem;
}
.footer-content {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 3rem;
  margin-bottom: 2rem;
}
.footer-logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 2rem;
  letter-spacing: 0.08em;
  margin-bottom: 0.75rem;
}
.footer-logo span { color: var(--accent); }
.footer-brand p { color: var(--text2); font-size: 0.875rem; line-height: 1.7; margin-bottom: 1rem; }

.social-links { display: flex; gap: 0.6rem; }
.social-links a {
  width: 36px; height: 36px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  color: var(--text2);
  font-size: 0.85rem;
  font-weight: 700;
  transition: all var(--transition);
}
.social-links a:hover { background: var(--accent); border-color: var(--accent); color: #fff; }

.footer-col h4 { font-size: 0.9rem; font-weight: 700; color: var(--text); margin-bottom: 1rem; }
.footer-col a {
  display: block;
  color: var(--text2);
  font-size: 0.85rem;
  padding: 0.3rem 0;
  transition: color var(--transition);
}
.footer-col a:hover { color: var(--accent); }

.footer-bottom {
  border-top: 1px solid var(--border);
  padding-top: 1.25rem;
  text-align: center;
  color: var(--text3);
  font-size: 0.8rem;
}

/* ── 17. MODALS ───────────────────────────────────────────── */
.modal-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.85);
  backdrop-filter: blur(8px);
  z-index: 5000;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; visibility: hidden;
  transition: opacity var(--transition), visibility var(--transition);
  padding: 1rem;
}
.modal-overlay.active { opacity: 1; visibility: visible; }
.modal-overlay.active .modal { transform: scale(1) translateY(0); opacity: 1; }

.modal {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 2.5rem;
  width: 100%;
  max-width: 440px;
  position: relative;
  transform: scale(0.92) translateY(20px);
  opacity: 0;
  transition: all 0.35s cubic-bezier(0.4,0,0.2,1);
  max-height: 90vh;
  overflow-y: auto;
}
.modal.modal-wide { max-width: 640px; }
.modal.modal-player { max-width: 800px; padding: 0; background: #000; border-radius: var(--radius-lg); overflow: hidden; }

.modal-close {
  position: absolute; top: 1rem; left: 1rem;
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.15);
  color: var(--text2);
  width: 32px; height: 32px;
  border-radius: 50%;
  font-size: 0.8rem;
  display: flex; align-items: center; justify-content: center;
  transition: all var(--transition);
}
.modal-close:hover { background: var(--accent); border-color: var(--accent); color: #fff; }

.modal-logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.8rem;
  letter-spacing: 0.08em;
  text-align: center;
  margin-bottom: 0.5rem;
}
.modal-logo span { color: var(--accent); }

.modal h2 {
  font-size: 1.4rem;
  text-align: center;
  color: var(--text);
  margin-bottom: 1.75rem;
}

/* ── 18. FORMS ────────────────────────────────────────────── */
.form-group { margin-bottom: 1.1rem; }
.form-group label {
  display: block;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text2);
  margin-bottom: 0.4rem;
}
.form-group input, .form-group select {
  width: 100%;
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: 8px;
  color: var(--text);
  padding: 0.7rem 1rem;
  font-size: 0.9rem;
  outline: none;
  transition: border-color var(--transition), box-shadow var(--transition);
}
.form-group input:focus, .form-group select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(229,9,20,0.12);
}
.form-group input::placeholder { color: var(--text3); }

.input-eye { position: relative; }
.input-eye input { padding-left: 2.5rem; }
.input-eye button {
  position: absolute; left: 0.75rem; top: 50%;
  transform: translateY(-50%);
  background: none; border: none;
  color: var(--text3); font-size: 0.9rem;
  transition: color var(--transition);
}
.input-eye button:hover { color: var(--text); }

.pass-strength {
  height: 4px;
  background: var(--surface2);
  border-radius: 2px;
  margin-top: 0.4rem;
  overflow: hidden;
}
.strength-bar { height: 100%; width: 0; border-radius: 2px; transition: width 0.3s, background 0.3s; }
#strengthText { color: var(--text3); font-size: 0.75rem; margin-top: 0.25rem; display: block; }

.form-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; }
.check-label {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 0.83rem; color: var(--text2);
  cursor: none;
}
.check-label input[type=checkbox] {
  width: 15px; height: 15px;
  accent-color: var(--accent);
  cursor: none;
}
.check-label a { color: var(--accent); }

.forgot { font-size: 0.82rem; color: var(--accent); }
.forgot:hover { color: var(--accent2); }

.btn-submit {
  width: 100%;
  background: var(--accent);
  border: none;
  color: #fff;
  padding: 0.85rem;
  border-radius: var(--radius);
  font-size: 1rem;
  font-weight: 700;
  margin-top: 1rem;
  transition: background var(--transition), box-shadow var(--transition);
}
.btn-submit:hover { background: var(--accent2); box-shadow: var(--glow); }

.switch-modal { text-align: center; font-size: 0.85rem; color: var(--text2); margin-top: 1rem; }
.switch-modal a { color: var(--accent); }

.social-auth { margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1.25rem; }
.social-auth p { text-align: center; font-size: 0.8rem; color: var(--text3); margin-bottom: 0.75rem; }
.social-btns { display: flex; gap: 0.75rem; }
.social-btn {
  flex: 1;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--text2);
  padding: 0.65rem;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 600;
  transition: all var(--transition);
}
.social-btn.google:hover { border-color: #4285F4; color: #4285F4; }
.social-btn.facebook:hover { border-color: #1877F2; color: #1877F2; }

/* ── 19. PLAN SELECTOR (in modal) ────────────────────────── */
.plan-selector { margin-bottom: 1.25rem; }
.plan-selector p { font-size: 0.82rem; color: var(--text2); margin-bottom: 0.5rem; }
.plan-options { display: flex; gap: 0.5rem; }
.plan-opt {
  flex: 1;
  display: flex; align-items: center; justify-content: center; gap: 0.4rem;
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: 8px;
  padding: 0.5rem 0.75rem;
  font-size: 0.82rem;
  color: var(--text2);
  cursor: none;
  transition: all var(--transition);
}
.plan-opt:has(input:checked) { border-color: var(--accent); color: var(--accent); background: rgba(229,9,20,0.08); }
.plan-opt input { accent-color: var(--accent); }

/* ── 20. PROFILE ──────────────────────────────────────────── */
.profile-header {
  display: flex; align-items: center; gap: 1.25rem;
  margin-bottom: 1.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--border);
}
.profile-avatar-big {
  width: 70px; height: 70px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), #7928ca);
  display: flex; align-items: center; justify-content: center;
  font-size: 2rem;
  flex-shrink: 0;
  border: 3px solid var(--accent);
}
.profile-header h3 { font-size: 1.2rem; font-weight: 700; margin-bottom: 0.2rem; }
.profile-header p { font-size: 0.85rem; color: var(--text2); }
.plan-badge-sm {
  display: inline-block;
  background: rgba(229,9,20,0.15);
  border: 1px solid rgba(229,9,20,0.4);
  color: var(--accent2);
  font-size: 0.72rem;
  padding: 0.2rem 0.6rem;
  border-radius: 50px;
  margin-top: 0.4rem;
}

.profile-tabs { display: flex; gap: 0.4rem; margin-bottom: 1.5rem; }
.tab {
  flex: 1;
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text2);
  padding: 0.55rem;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 600;
  transition: all var(--transition);
}
.tab.active { background: var(--accent); border-color: var(--accent); color: #fff; }
.tab:hover:not(.active) { border-color: var(--accent); color: var(--accent); }

.tab-content { display: none; }
.tab-content.active { display: block; }

.watch-history { display: flex; flex-direction: column; gap: 0.75rem; }
.watch-item {
  display: flex; align-items: center; gap: 0.75rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0.6rem 0.85rem;
}
.watch-thumb { width: 45px; height: 64px; border-radius: 5px; object-fit: cover; }
.watch-details { flex: 1; }
.watch-title { font-size: 0.85rem; font-weight: 600; margin-bottom: 0.2rem; }
.watch-date { font-size: 0.75rem; color: var(--text3); }

/* ── 21. PLAYER ───────────────────────────────────────────── */
.player-area {
  background: #000;
  aspect-ratio: 16/9;
  display: flex; align-items: center; justify-content: center;
}
.player-placeholder {
  text-align: center; color: var(--text2);
}
.player-icon {
  font-size: 4rem;
  width: 80px; height: 80px;
  background: rgba(229,9,20,0.2);
  border: 2px solid var(--accent);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 1rem;
  animation: pulse 2s ease infinite;
}
@keyframes pulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(229,9,20,0.4); }
  50%      { box-shadow: 0 0 0 15px rgba(229,9,20,0); }
}
.player-bar {
  width: 200px;
  height: 3px;
  background: var(--surface2);
  border-radius: 2px;
  margin: 1rem auto 0;
  overflow: hidden;
}
.player-progress {
  height: 100%;
  background: var(--accent);
  width: 30%;
  animation: loadProgress 2s ease infinite;
}
@keyframes loadProgress { 0% { width: 0 } 100% { width: 60% } }

.player-info {
  background: var(--surface);
  padding: 1rem 1.5rem;
}
.player-info h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; }
.player-controls {
  display: flex; align-items: center; gap: 0.75rem;
}
.player-controls button {
  background: none; border: none; color: var(--text2);
  font-size: 1.2rem; padding: 0.3rem;
  transition: color var(--transition);
}
.player-controls button:hover { color: var(--text); }
.play-btn { color: var(--accent) !important; font-size: 1.4rem !important; }
.vol { display: flex; align-items: center; gap: 0.4rem; font-size: 1rem; color: var(--text2); }
.vol input { width: 70px; accent-color: var(--accent); }
.time { font-size: 0.78rem; color: var(--text2); margin-right: auto; }
.fullscreen-btn { font-size: 1rem !important; }

/* ── 22. TOAST ────────────────────────────────────────────── */
#toast {
  position: fixed;
  bottom: 2rem; left: 50%;
  transform: translateX(-50%) translateY(100px);
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 50px;
  padding: 0.7rem 1.5rem;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text);
  box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  z-index: 9999;
  transition: transform 0.4s cubic-bezier(0.4,0,0.2,1);
  white-space: nowrap;
}
#toast.show { transform: translateX(-50%) translateY(0); }
#toast.success { border-color: #22c55e; color: #22c55e; }
#toast.error   { border-color: var(--accent); color: var(--accent); }

/* ── 23. MOVIE DETAIL ─────────────────────────────────────── */
.movie-detail { display: flex; gap: 2rem; }
.movie-detail-poster { width: 180px; flex-shrink: 0; border-radius: var(--radius); overflow: hidden; }
.movie-detail-poster img { width: 100%; border-radius: var(--radius); }
.movie-detail-info { flex: 1; }
.movie-detail-info h2 { font-size: 1.6rem; font-weight: 700; margin-bottom: 0.5rem; }
.movie-detail-meta { display: flex; gap: 0.75rem; color: var(--text2); font-size: 0.85rem; margin-bottom: 1rem; flex-wrap: wrap; }
.movie-detail-desc { color: var(--text2); font-size: 0.9rem; line-height: 1.7; margin-bottom: 1.25rem; }
.movie-detail-btns { display: flex; gap: 0.75rem; flex-wrap: wrap; }

/* ── 24. SEARCH RESULTS OVERLAY ───────────────────────────── */
.search-overlay {
  position: fixed; top: 70px; left: 0; right: 0;
  background: rgba(8,11,20,0.97);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
  padding: 1.5rem 4rem;
  z-index: 900;
  max-height: 60vh; overflow-y: auto;
  transform: translateY(-100%);
  transition: transform var(--transition);
}
.search-overlay.active { transform: translateY(0); }
.search-result-item {
  display: flex; align-items: center; gap: 1rem;
  padding: 0.75rem;
  border-radius: 8px;
  transition: background var(--transition);
  cursor: none;
}
.search-result-item:hover { background: var(--surface); }
.search-result-thumb { width: 50px; height: 70px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
.search-result-title { font-weight: 600; margin-bottom: 0.2rem; }
.search-result-meta { font-size: 0.8rem; color: var(--text2); }

/* ── 25. ANIMATIONS ───────────────────────────────────────── */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slideInRight {
  from { opacity: 0; transform: translateX(30px); }
  to   { opacity: 1; transform: translateX(0); }
}
@keyframes shimmer {
  0%   { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.animate-up { animation: fadeInUp 0.6s ease both; }
.animate-up:nth-child(1) { animation-delay: 0.05s; }
.animate-up:nth-child(2) { animation-delay: 0.1s; }
.animate-up:nth-child(3) { animation-delay: 0.15s; }
.animate-up:nth-child(4) { animation-delay: 0.2s; }
.animate-up:nth-child(5) { animation-delay: 0.25s; }
.animate-up:nth-child(6) { animation-delay: 0.3s; }
.animate-up:nth-child(7) { animation-delay: 0.35s; }
.animate-up:nth-child(8) { animation-delay: 0.4s; }

/* ── 26. SKELETON LOADING ─────────────────────────────────── */
.skeleton {
  background: linear-gradient(90deg, var(--surface) 25%, var(--surface2) 50%, var(--surface) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius);
}
.skeleton-card { aspect-ratio: 2/3; }
.skeleton-row { height: 100px; border-radius: 8px; }

/* ── 27. NOTIFICATION DOT ────────────────────────────────── */
.notif-dot {
  width: 8px; height: 8px;
  background: var(--accent);
  border-radius: 50%;
  position: absolute; top: -2px; right: -2px;
  animation: pulseDot 1.5s ease infinite;
}
@keyframes pulseDot {
  0%,100% { transform: scale(1); opacity: 1; }
  50%      { transform: scale(1.5); opacity: 0.6; }
}

/* ── 28. RESPONSIVE ───────────────────────────────────────── */
@media (max-width: 1100px) {
  .stats-bar { grid-template-columns: repeat(2,1fr); padding: 1.5rem 2rem; }
  .categories-grid { grid-template-columns: repeat(4,1fr); }
  .footer-content { grid-template-columns: 1fr 1fr; gap: 2rem; }
}

@media (max-width: 900px) {
  .nav-links { display: none; }
  .nav-search input { width: 140px; }
  .section { padding: 2rem 1.5rem; }
  .featured-banner { margin: 0 1.5rem; flex-direction: column; }
  .featured-image { width: 100%; height: 200px; }
  .plans-grid { grid-template-columns: 1fr; max-width: 380px; }
  .hero-content { padding: 0 2rem; }
  .movies-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .categories-grid { grid-template-columns: repeat(2,1fr); }
  .footer-content { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
}

@media (max-width: 600px) {
  .stats-bar { grid-template-columns: repeat(2,1fr); padding: 1rem; }
  .stat-item { border: none; border-bottom: 1px solid var(--border); }
  .hero-btns { flex-direction: column; }
  .hero-title { font-size: 2.5rem; }
  .section { padding: 2rem 1rem; }
  .featured-banner { margin: 0 1rem; }
